# file: .
# owner: 0
# group: 1000
user::rwx
group::r-x
other::r-x

# file: ./default
# owner: 0
# group: 0
user::rwx
group::r-x
other::r-x
default:user::rwx
default:user:34567:r--
default:group::r-x
default:mask::r-x
default:other::r-x

# file: ./default/child
# owner: 0
# group: 0
user::rw-
user:34567:r--
group::r-x	#effective:r--
mask::r--
other::r--

# file: ./file
# owner: 12345
# group: 23456
user::rw-
user:34567:r--
group::r--
mask::r--
other::---

# file: ./hardlink
# owner: 12345
# group: 23456
user::rw-
user:34567:r--
group::r--
mask::r--
other::---

# file: ./setgid
# owner: 12345
# group: 23456
# flags: -s-
user::rwx
group::r-x
other::---

# file: ./setuid
# owner: 12345
# group: 23456
# flags: s--
user::rwx
group::r-x
other::---

# file: ./symlink
# owner: 12345
# group: 23456
user::rw-
user:34567:r--
group::r--
mask::r--
other::---

