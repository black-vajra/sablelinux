#!/bin/sh

choice=$(
    printf '%s\n' 'Screen lock' 'Log off' 'Reboot' 'Shut down' |
        fuzzel --dmenu --prompt='Power: '
) || exit 0

case "$choice" in
    'Screen lock') exec swaylock -f -c 000000 ;;
    'Log off')
        if [ -z "${XDG_SESSION_ID:-}" ]; then
            printf '%s\n' 'No login session ID is available.' >&2
            exit 1
        fi
        exec loginctl terminate-session "$XDG_SESSION_ID"
        ;;
    'Reboot') action=reboot ;;
    'Shut down') action=poweroff ;;
    *) exit 0 ;;
esac

if [ "${SABLE_LIVE_SESSION:-}" = 1 ]; then
    set -- sudo -n systemctl "$action"
else
    set -- systemctl "$action"
fi

if ! error=$("$@" 2>&1); then
    printf '%s failed: %s\n' "$choice" "$error" >&2
    exec swaynag -t error -m "$choice failed: $error"
fi
