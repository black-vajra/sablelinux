#!/usr/bin/env python3
import fcntl
import html
import json
import os
import re
import subprocess
import sys

if sys.argv[1:] == ["--menu"]:
    runtime = os.environ.get("XDG_RUNTIME_DIR")
    if not runtime:
        raise SystemExit("XDG_RUNTIME_DIR is unavailable")
    with open(os.path.join(runtime, "sable-sensors-menu.lock"), "a") as lock:
        try:
            fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except BlockingIOError:
            raise SystemExit(0)
        try:
            readings = subprocess.check_output(
                ["sensors"], text=True, stderr=subprocess.STDOUT, timeout=2,
            )
        except (OSError, subprocess.SubprocessError):
            readings = "Sensor readings unavailable\n"
        subprocess.run(
            ["fuzzel", "--dmenu", "--prompt=Sensors: "],
            input=readings, text=True, stdout=subprocess.DEVNULL,
        )
    raise SystemExit(0)

try:
    output = subprocess.check_output(
        ["sensors"], text=True, env={**os.environ, "LC_ALL": "C"},
        stderr=subprocess.STDOUT, timeout=1.5,
    ).strip()
except (OSError, subprocess.SubprocessError):
    print(json.dumps({"text": "—", "tooltip": "Sensor readings unavailable", "class": "unavailable"}))
    raise SystemExit(0)

chips = []
for block in re.split(r"\n\s*\n", output):
    lines = block.splitlines()
    if not lines:
        continue
    readings = [
        (float(value), label.strip())
        for label, value in re.findall(
            r"^([^:\n]+):[ \t]*([+-]?\d+(?:\.\d+)?)\s*°C", block, re.M
        )
    ]
    if readings:
        temperature, label = max(readings)
        chips.append((lines[0], temperature, label))

text = " / ".join(f"{temp:g}°C" for _, temp, _ in chips) or "—"
summary = "\n".join(f"{chip}: {temp:g}°C ({label})" for chip, temp, label in chips)
tooltip = f"{summary}\n\n{output}" if summary else output
print(json.dumps({"text": text, "tooltip": html.escape(tooltip)}))
