#!/usr/bin/env python3
import json
from pathlib import Path
import subprocess
import sys
import time

WG = "client1"

def run(*args):
    try:
        return subprocess.check_output(
            args, text=True, stderr=subprocess.DEVNULL, timeout=3
        )
    except (OSError, subprocess.SubprocessError):
        return ""

def ip_json(*args):
    return json.loads(run("ip", "-j", "-4", *args) or "[]")

def address(interface):
    return next(
        (entry["local"] for entry in interface.get("addr_info", [])
         if entry.get("family") == "inet" and entry.get("scope") == "global"),
        "",
    )

def vpn(interfaces):
    tunnel = address(interfaces.get(WG, {}))
    if not tunnel:
        return "WG down", "WireGuard disconnected", "down"
    result = run("sudo", "-n", "/usr/bin/wg", "show", WG, "latest-handshakes")
    stamp = max(
        (int(fields[1]) for line in result.splitlines()
         if len(fields := line.split()) == 2 and fields[1].isdigit()),
        default=0,
    )
    age = int(time.time()) - stamp
    if stamp and 0 <= age <= 180:
        return f"WG {tunnel}", f"Last handshake: {age} seconds ago", "up"
    return "WG down", "WireGuard handshake unavailable or stale", "down"

def lan(interfaces):
    routes = sorted(
        ip_json("route", "show", "table", "main", "default"),
        key=lambda route: route.get("metric", 0),
    )
    devices = [route.get("dev") for route in routes]
    devices += [name for name in interfaces if
                (Path("/sys/class/net") / name / "device").exists()]
    for name in devices:
        if name and name != WG:
            local = address(interfaces.get(name, {}))
            if local:
                return f"LAN {local}", f"Local network: {name}", "up"
    return "LAN down", "No local IPv4 address", "down"

if __name__ == "__main__":
    interfaces = {item["ifname"]: item for item in ip_json("address", "show", "up")}
    mode = {"vpn": vpn, "lan": lan}[sys.argv[1]]
    text, tooltip, state = mode(interfaces)
    print(json.dumps({"text": text, "tooltip": tooltip, "class": state}))
