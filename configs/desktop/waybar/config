{
    "layer": "top",
    "position": "top",
    "height": 32,
    "spacing": 6,

    "modules-left": ["sway/workspaces", "sway/mode", "sway/window"],
    "modules-center": ["clock"],
    "modules-right": ["network", "pulseaudio", "cpu", "memory", "temperature", "keyboard-state"],

    "sway/workspaces": {
        "disable-scroll": true,
        "all-outputs": true,
        "format": "{name}"
    },

    "sway/mode": {
        "format": "  {}"
    },

    "sway/window": {
        "max-length": 60
    },

    "clock": {
        "timezone": "America/New_York",
        "format": "  {:%Y-%m-%d  %H:%M:%S}",
        "interval": 1,
        "tooltip": false
    },

    "cpu": {
        "format": "  {usage}%",
        "interval": 2
    },

    "memory": {
        "format": "  {}%",
        "interval": 5
    },

    "temperature": {
        "critical-threshold": 85,
        "format": "  {temperatureC}°C"
    },

    "network": {
        "interface": "wg0",
        "format-ethernet": "  {ipaddr}",
        "format-disconnected": "  down",
        "interval": 5
    },

    "pulseaudio": {
        "format": "  {volume}%",
        "format-muted": "  muted",
        "on-click": "pactl set-sink-mute @DEFAULT_SINK@ toggle"
    },

    "keyboard-state": {
        "capslock": true,
        "numlock": true,
        "format": "  {name} {icon}",
        "format-icons": {
            "locked": "on",
            "unlocked": ""
        }
    }
}
