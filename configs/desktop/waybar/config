{
    "layer": "top",
    "position": "top",
    "height": 32,
    "spacing": 6,

    "modules-left": ["sway/workspaces", "custom/workspace-label", "sway/mode"],
    "modules-center": ["clock"],
    "custom/power": {
        "format": "⏻",
        "tooltip": true,
        "tooltip-format": "Power and session",
        "on-click": "$HOME/.local/bin/sable-power-menu"
    },
        "custom/temperature": {
        "format": " {}",
        "exec": "$HOME/.local/bin/sable-sensors",
        "return-type": "json",
        "interval": 2,
        "tooltip": true,
        "on-click": "$HOME/.local/bin/sable-sensors --menu"
    },
    "modules-right": ["custom/vpn", "custom/lan", "pulseaudio", "cpu", "memory", "custom/temperature", "keyboard-state", "battery", "custom/power"],

    "custom/workspace-label": {
        "format": "▾",
        "tooltip-format": "Label the focused workspace",
        "on-click": "$HOME/.local/bin/sable-workspace-label"
    },
    "sway/workspaces": {
        "disable-scroll": true,
        "all-outputs": true,
        "format": "{name}"
    },

    "sway/mode": {
        "format": "  {}"
    },

    "sway/window": {
        "max-length": 60
    },

    "clock": {
        "timezone": "America/New_York",
        "format": "  {:%Y-%m-%d  %H:%M:%S}",
        "interval": 1,
        "tooltip": false
    },

    "cpu": {
        "format": "  {usage}%",
        "interval": 2
    },

    "memory": {
        "format": "  {}%",
        "interval": 5
    },

    "temperature": {
        "critical-threshold": 85,
        "format": "  {temperatureC}°C"
    },

    "custom/vpn": {
        "exec": "$HOME/.local/bin/sable-network-status vpn",
        "interval": 10,
        "return-type": "json",
        "format": " {}",
        "tooltip": true
    },

    "custom/lan": {
        "exec": "$HOME/.local/bin/sable-network-status lan",
        "interval": 10,
        "return-type": "json",
        "format": "{}",
        "tooltip": true
    },

    "battery": {
        "format": "{icon} {capacity}%",
        "format-icons": ["", "", "", "", ""],
        "full-at-plugged": true,
        "tooltip": true,
        "tooltip-format": "Battery charge: {capacity}%",
        "tooltip-format-charging": "Battery charge: {capacity}% · Plugged in (charging)",
        "tooltip-format-plugged": "Battery charge: {capacity}% · Plugged in",
        "tooltip-format-discharging": "Battery charge: {capacity}% · Unplugged"
    },

    "pulseaudio": {
        "format": "  {volume}%",
        "format-muted": "  muted",
        "on-click": "pactl set-sink-mute @DEFAULT_SINK@ toggle"
    },

    "keyboard-state": {
        "capslock": true,
        "numlock": true,
        "format": "  {name} {icon}",
        "format-icons": {
            "locked": "on",
            "unlocked": ""
        }
    }
}
